# Inputs for `npm run local-action`. Copy to .env and fill in.
# GitHub Actions passes inputs as INPUT_<NAME> with dashes preserved.

# Credentials - set exactly one of the three.
INPUT_YC-SA-JSON-CREDENTIALS=
INPUT_YC-IAM-TOKEN=
INPUT_YC-SA-ID=

# Required.
INPUT_FOLDER-ID=
INPUT_CONTAINER-NAME=
INPUT_REVISION-IMAGE-URL=

# Any non-empty value makes the container publicly invokable, including the
# string "false". Leave blank to keep it private.
INPUT_PUBLIC=

# Revision resources.
INPUT_REVISION-CORES=1
INPUT_REVISION-MEMORY=128Mb
INPUT_REVISION-CORE-FRACTION=100
INPUT_REVISION-CONCURRENCY=1
INPUT_REVISION-EXECUTION-TIMEOUT=3
INPUT_REVISION-PROVISIONED=
INPUT_REVISION-ZONE-INSTANCES-LIMIT=
INPUT_REVISION-ZONE-REQUESTS-LIMIT=

# Container process.
INPUT_REVISION-SERVICE-ACCOUNT-ID=
INPUT_REVISION-WORKING-DIR=
INPUT_REVISION-COMMANDS=
INPUT_REVISION-ARGS=
INPUT_REVISION-ENV=
INPUT_REVISION-RUNTIME=http
INPUT_REVISION-NETWORK-ID=

# Secrets. Pattern: ENV_VAR=secretId/versionId/key
INPUT_REVISION-SECRETS=

# Mounts.
INPUT_REVISION-STORAGE-MOUNTS=
INPUT_REVISION-EPHEMERAL-MOUNTS=

# Logging.
INPUT_REVISION-LOG-OPTIONS-DISABLED=false
INPUT_REVISION-LOG-OPTIONS-LOG-GROUP-ID=
INPUT_REVISION-LOG-OPTIONS-FOLDER-ID=
INPUT_REVISION-LOG-OPTIONS-MIN-LEVEL=level_unspecified

# Runner context the action reads through @actions/github.
GITHUB_REPOSITORY=owner/repo
