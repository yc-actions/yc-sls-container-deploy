{
  "name": "yc-actions-yc-sls-container-deploy",
  "version": "4.5.0",
  "description": "GitHub Action to deploy Serverless Container to Yandex Cloud",
  "main": "lib/src/index.js",
  "scripts": {
    "build": "tsc",
    "format": "prettier --write '**/*.ts'",
    "format-check": "prettier --check '**/*.ts'",
    "lint": "eslint src/**/*.ts --fix",
    "package": "ncc build --source-map --license licenses.txt",
    "test": "GITHUB_WORKSPACE=__tests__ jest --verbose",
    "all": "npm run build && npm run format && npm run lint && npm run package && npm test",
    "git-tag": "git tag v`cat package.json | jq -r '.version' | awk -F. '{print $1}'` -f &&  git tag v`cat package.json | jq -r '.version'` -f"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yc-actions/yc-sls-container-deploy.git"
  },
  "keywords": [
    "actions",
    "yandex cloud",
    "serverless containers",
    "deploy"
  ],
  "author": "Nikolay Matrosov",
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^2.0.3",
    "@actions/github": "^7.0.0",
    "@grpc/grpc-js": "^1.14.4",
    "@supercharge/promise-pool": "^3.3.0",
    "@yandex-cloud/nodejs-sdk": "^3.2.0",
    "axios": "^1.18.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^9.39.5",
    "@stylistic/eslint-plugin-ts": "^4.4.1",
    "@types/jest": "^30.0.0",
    "@types/mustache": "^4.2.6",
    "@types/node": "^26.1.1",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vercel/ncc": "^0.44.1",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.5",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-github": "^6.1.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^29.16.0",
    "eslint-plugin-jsonc": "^3.3.0",
    "eslint-plugin-prefer-arrow-functions": "^3.10.1",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-unicorn": "^62.0.0",
    "globals": "^17.7.0",
    "jest": "^30.4.2",
    "js-yaml": "^5.2.2",
    "prettier": "3.9.6",
    "ts-jest": "^29.4.12",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=24.9.0"
  }
}
